  aiBtnTxt:        { color: C.accent, fontSize: 15, fontWeight: '600', flex: 1 },

  // Pro gate
  proGate:         { backgroundColor: C.card, borderRadius: 12, padding: 16, marginBottom: 16, alignItems: 'center', borderWidth: 1, borderColor: C.border },
