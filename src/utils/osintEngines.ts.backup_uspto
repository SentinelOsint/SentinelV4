    { label: 'Cash App', value: `https://cash.app/$${u}`, type: 'link' },
    { label: '─── OSINT AGGREGATORS', value: '', type: 'info' },
    { label: 'Sherlock (Web)', value: `https://sherlock-project.github.io/`, type: 'link' },
